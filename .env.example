# Copy to .env and fill in. Commands read these from the environment, e.g.:
#   set -a; source .env; set +a

# Developer API key for AnythingLLM. On a fresh instance (no password set), create one with:
#   curl -s -X POST localhost:3001/api/system/generate-api-key \
#     -H 'Content-Type: application/json' -d '{"name":"rag-eval"}' | jq -r .apiKey.secret
ANYTHINGLLM_API_KEY=

# AnythingLLM base URL as seen from the host (default: http://localhost:3001).
ANYTHINGLLM_BASE_URL=http://localhost:3001

# Container name used to verify the pinned image digest (default: rag-eval-anythingllm).
ANYTHINGLLM_CONTAINER=rag-eval-anythingllm

# Ollama on the host, used to verify pinned model digests (default: http://localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic API key, used only by `rag-eval dataset generate` (question generation with
# claude-sonnet-5-5; see docs/decisions/0004-dataset-size-and-generation.md). Every run
# prints a cost estimate and asks before spending. Not needed for PR CI.
ANTHROPIC_API_KEY=
